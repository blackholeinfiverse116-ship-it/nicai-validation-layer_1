{
  "identity_type": "RUNTIME_IDENTITY_CARD",
  "identity_version": "1.0",
  "system_name": "NICAI",
  "system_full_name": "Networked Intelligence & Context Analysis Interface",
  "system_role": "DETERMINISTIC_INTELLIGENCE_LAYER",
  "system_category": "DECISION_SUPPORT_RUNTIME",

  "ownership": {
    "owner": "NICAI",
    "responsibility": [
      "signal validation",
      "deterministic intelligence generation",
      "multi-signal pattern analysis",
      "trace propagation",
      "explainable intelligence output",
      "bounded integration adapter preparation"
    ],
    "decision_authority": false,
    "execution_authority": false
  },

  "constitutional_position": {
    "role": "INTELLIGENCE_PROVIDER",
    "may_generate_decision_signals": true,
    "may_execute_decisions": false,
    "may_execute_external_actions": false,
    "may_override_authority": false,
    "may_claim_external_registry_ownership": false
  },

  "runtime_properties": {
    "deterministic": true,
    "replayable": true,
    "traceable": true,
    "explainable": true,
    "audit_ready": true,
    "black_box_ai": false
  },

  "primary_pipeline": [
    "DATASET",
    "SAMACHAR_INPUT_ADAPTER",
    "SIGNAL_CONVERSION",
    "VALIDATION_LAYER",
    "SANSKAR_INTELLIGENCE_ENGINE",
    "MULTI_SIGNAL_PATTERN_ANALYSIS",
    "FASTAPI_LAYER",
    "DASHBOARD",
    "ACTION_ROUTER_SIMULATION",
    "LOGGING",
    "REPLAY",
    "ECOSYSTEM_ADAPTERS"
  ],

  "traceability": {
